---
// En Astro, este bloque superior se usa para imports y lógica antes del HTML.
// Piensa en él como la parte "TypeScript/JavaScript" del archivo `.astro`.
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Raimundo Plaza | CV Web</title>
  </head>

  <!-- `body` aplica estilos base a toda la página renderizada. -->
  <body class="min-h-screen bg-neutral-950 text-neutral-100">
    <!-- `main` contiene el contenido principal y limita el ancho para controlar el layout. -->
    <main class="mx-auto max-w-5xl px-6 py-16">
      <!-- `section` agrupa este bloque como una unidad semántica dentro de la página. -->
      <section class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-8">
        <p class="text-sm text-neutral-400">
          Desarrollador / Analista Programador
        </p>

        <!-- `h1` marca el título principal del documento a nivel semántico. -->
        <h1 class="mt-3 text-4xl font-bold tracking-tight">
          Raimundo Plaza
        </h1>

        <!-- Este párrafo agrega contexto al bloque principal sin cambiar su jerarquía semántica. -->
        <p class="mt-4 max-w-2xl text-neutral-300">
          Construyo interfaces claras, mantenibles y orientadas a resolver problemas reales.
        </p>
      </section>
    </main>
  </body>
</html>
